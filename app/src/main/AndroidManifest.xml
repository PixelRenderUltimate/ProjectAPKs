<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PHASE 1 = DETEKSI SAJA. Tidak ada permission berbahaya, tidak ada root,
      tidak ada akses ke data/APK game.
    -->

    <!-- Permission Shizuku (opsional). Tanpa Shizuku aplikasi tetap jalan. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      PHASE 6: pengingat setelah reboot. Override resolusi bertahan setelah
      reboot, Shizuku mode ADB tidak. Receiver hanya membuat notifikasi,
      tidak pernah menulis ke perangkat.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vulkan opsional: perangkat tanpa Vulkan tetap boleh memasang aplikasi. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
      Kita TIDAK memakai QUERY_ALL_PACKAGES. Hanya package target yang
      dideklarasikan, sesuai kebijakan Play Store.
    -->
    <queries>
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".PixelRenderApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelRender">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:label="@string/app_name"
            android:theme="@style/Theme.PixelRender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tidak diekspor: BOOT_COMPLETED dikirim oleh sistem, bukan aplikasi lain. -->
        <receiver
            android:name=".recovery.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Provider wajib untuk Shizuku API v13 (pre-v11 compatibility). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
